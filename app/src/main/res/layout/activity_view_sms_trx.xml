<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f8f9fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Background -->
    <View
        android:id="@+id/headerBackground"
        android:background="#FF9800"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/backButton"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back"
                android:layout_centerVertical="true"
                app:tint="@android:color/white"
                android:contentDescription="Back" />

            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS Transactions"
                android:layout_centerInParent="true" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Search Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etSearchTrx"
                android:textSize="14sp"
                android:background="@drawable/edit_text_rounded"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Search by Transaction ID"
                android:drawablePadding="12dp"
                android:paddingHorizontal="12dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/edit_text_rounded"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etDateFilter"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="Select Date"
                    android:drawablePadding="12dp"
                    android:layout_weight="1"
                    android:importantForAutofill="no" />

                <ImageButton
                    android:id="@+id/btnClearDate"
                    android:background="?selectableItemBackgroundBorderless"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Clear date" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter Buttons -->
    <LinearLayout
        android:id="@+id/buttonGroup"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAll"
            android:textSize="13sp"
            android:textColor="@color/filter_text_selector"
            android:background="@drawable/filter_btn_bg"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="All"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSuccess"
            android:textSize="13sp"
            android:textColor="@color/filter_text_selector"
            android:background="@drawable/filter_btn_bg"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="Success"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWaiting"
            android:textSize="13sp"
            android:textColor="@color/filter_text_selector"
            android:background="@drawable/filter_btn_bg"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="Waiting"
            android:layout_weight="1"
            android:textAllCaps="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:textSize="16sp"
        android:textColor="#6c757d"
        android:gravity="center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/buttonGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="No SMS transactions found" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSmsList"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/buttonGroup"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
